DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce
JWT_SECRET=secret
ORDER_EXPIRE_MINUTES=1
CORS_ORIGIN=http://localhost:5173

# Object storage — MinIO locally, Amazon S3 when S3_PROVIDER=aws
S3_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=products
# S3_FORCE_PATH_STYLE / S3_CREATE_BUCKET: unset = inferred (MinIO on, AWS off)
#
# Amazon S3 (create the bucket in the console first):
# S3_PROVIDER=aws
# S3_REGION=eu-central-1
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...
# S3_BUCKET=your-globally-unique-bucket

# Redis cache (product catalog)
REDIS_URL=redis://localhost:6379
CACHE_TTL_MS=30000

# RabbitMQ + Mailhog (order emails)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=shop@localhost
